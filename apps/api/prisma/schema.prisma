// VOLTSTAR — Prisma schema (скелет ключових моделей).
// Розширюється по фазах дорожньої карти (docs/ROADMAP.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Enums ───────────────────────────
enum Segment {
  B2C
  B2B
  B2G
}

enum OrgType {
  INDIVIDUAL
  BUSINESS
  GOVERNMENT
}

enum Role {
  GUEST
  CUSTOMER
  MANAGER
  ADMIN
}

enum Currency {
  UAH
  USD
  EUR
}

enum FuelType {
  PETROL
  DIESEL
  GAS
  DUAL_FUEL
  INVERTER
}

enum PhaseType {
  SINGLE
  THREE
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  INVOICED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentProviderKind {
  WAYFORPAY
  LIQPAY
  STRIPE
  BANK_INVOICE
}

enum DeliveryMethod {
  PICKUP
  NOVA_POSHTA
  COURIER
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  DISQUALIFIED
}

enum DealStage {
  NEW
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

// ──────────────────── Accounts & Auth ────────────────────────
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  firstName    String?
  lastName     String?
  phone        String?
  role         Role     @default(CUSTOMER)
  orgId        String?
  organization Organization? @relation(fields: [orgId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders       Order[]
  carts        Cart[]
  assignedLeads Lead[] @relation("LeadOwner")
  assignedDeals Deal[] @relation("DealOwner")
  resetTokens  PasswordResetToken[]
  contact      Contact?
  crmTasks     Task[]     @relation("TaskAssignee")
  activities   Activity[] @relation("ActivityAuthor")
  auditLogs    AuditLog[] @relation("AuditActor")

  @@index([orgId])
}

// Одноразовий токен скидання паролю. Зберігаємо лише sha256-хеш токена.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  type      OrgType  @default(INDIVIDUAL)
  segment   Segment  @default(B2C)
  edrpou    String?  // код ЄДРПОУ (UA)
  vatNumber String?
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  orders    Order[]
  company   Company?

  @@index([segment])
}

// ─────────────────────────── Catalog ─────────────────────────
model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  products Product[]
}

model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]
}

model Product {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  brandId     String
  brand       Brand     @relation(fields: [brandId], references: [id])
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  fuel        FuelType
  phase       PhaseType
  ratedPowerW Int       // номінальна потужність, Вт
  maxPowerW   Int       // пікова потужність, Вт
  images      String[]  @default([])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  specs     ProductSpec[]
  prices    Price[]
  inventory InventoryItem?
  orderItems OrderItem[]
  cartItems  CartItem[]

  @@index([brandId])
  @@index([categoryId])
  @@index([ratedPowerW])
}

model ProductSpec {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String  // напр. "Обʼєм бака, л"
  value     String  // напр. "25"

  @@index([productId])
}

model InventoryItem {
  id        String  @id @default(cuid())
  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int     @default(0)
  warehouse String  @default("main")
}

// ─────────────────────────── Pricing ─────────────────────────
model PriceList {
  id        String   @id @default(cuid())
  name      String
  segment   Segment
  currency  Currency @default(UAH)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  prices    Price[]

  @@unique([segment, currency, name])
}

model Price {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceListId String
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  amountMinor Int       // ціна в мінімальних одиницях (копійки)
  vatRate     Float     @default(0.2)

  @@unique([productId, priceListId])
  @@index([productId])
}

// ──────────────────── Equipment presets (Selector) ───────────
model EquipmentPreset {
  id       String  @id @default(cuid())
  label    String  // напр. "Холодильник побутовий"
  powerW   Int
  loadType String  // RESISTIVE | INDUCTIVE | MOTOR | ELECTRONIC
  category String? // групування у формі підбору
}

// ──────────────────────── Cart & Orders ──────────────────────
model Cart {
  id        String     @id @default(cuid())
  userId    String?
  user      User?      @relation(fields: [userId], references: [id])
  currency  Currency   @default(UAH)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]

  @@index([userId])
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)

  @@unique([cartId, productId])
  @@index([cartId])
}

model Order {
  id          String      @id @default(cuid())
  number      String      @unique
  userId      String?
  user        User?       @relation(fields: [userId], references: [id])
  orgId       String?
  organization Organization? @relation(fields: [orgId], references: [id])
  segment     Segment     @default(B2C)
  status      OrderStatus @default(DRAFT)
  currency    Currency    @default(UAH)
  totalMinor  Int         @default(0)
  vatMinor    Int         @default(0)
  deliveryMethod DeliveryMethod @default(PICKUP)
  deliveryMinor  Int         @default(0)
  contactName  String?
  contactEmail String?
  contactPhone String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items     OrderItem[]
  payments  Payment[]
  invoices  Invoice[]
  events    OrderStatusEvent[]
  deal      Deal?

  @@index([userId])
  @@index([status])
}

// Журнал переходів статусу замовлення (хто, коли, чому).
model OrderStatusEvent {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  /// id користувача-менеджера або "system:<джерело>" (checkout, webhook:STRIPE, …)
  actor      String
  note       String?
  createdAt  DateTime     @default(now())

  @@index([orderId, createdAt])
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product @relation(fields: [productId], references: [id])
  quantity      Int     @default(1)
  unitPriceMinor Int
  vatRate       Float   @default(0.2)

  @@index([orderId])
}

// ─────────────────────────── Payments ────────────────────────
model Payment {
  id           String              @id @default(cuid())
  orderId      String
  order        Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider     PaymentProviderKind
  status       PaymentStatus       @default(PENDING)
  amountMinor  Int
  currency     Currency            @default(UAH)
  externalId   String?             // id транзакції у провайдера
  rawPayload   Json?               // сира відповідь/вебхук (для звірки)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([provider, externalId])
  @@index([orderId])
}

// Отримані вебхуки платіжних провайдерів — для ідемпотентної обробки.
model WebhookEvent {
  id         String              @id @default(cuid())
  provider   PaymentProviderKind
  eventId    String              // унікальний id події у провайдера
  receivedAt DateTime            @default(now())

  @@unique([provider, eventId])
}

model Invoice {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  number    String   @unique
  pdfUrl    String?  // посилання на PDF у S3/R2
  createdAt DateTime @default(now())

  @@index([orderId])
}

// ─────────────────────────── CRM ─────────────────────────────
// Компанія в CRM; для зареєстрованих B2B/B2G повʼязана з Organization (1:1).
model Company {
  id        String        @id @default(cuid())
  name      String
  edrpou    String?
  segment   Segment       @default(B2B)
  orgId     String?       @unique
  organization Organization? @relation(fields: [orgId], references: [id])
  createdAt DateTime      @default(now())
  contacts  Contact[]
  deals     Deal[]

  @@index([edrpou])
}

// Контактна особа; якщо є акаунт — повʼязана з User (1:1).
model Contact {
  id        String   @id @default(cuid())
  firstName String?
  lastName  String?
  email     String?
  phone     String?
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  deals     Deal[]

  @@index([companyId])
  @@index([email])
}

model Lead {
  id          String     @id @default(cuid())
  source      String     // selector-form | b2b-request | b2g-request | contact
  status      LeadStatus @default(NEW)
  segment     Segment    @default(B2C)
  name        String?
  email       String?
  phone       String?    // нормалізований (380XXXXXXXXX) — для пошуку дублікатів
  companyName String?
  edrpou      String?
  message     String?
  payload     Json?      // дані форми підбору тощо
  ownerId     String?
  owner       User?      @relation("LeadOwner", fields: [ownerId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deal        Deal?
  activities  Activity[]
  tasks       Task[]

  @@index([ownerId, status])
  @@index([email])
  @@index([phone])
}

model Deal {
  id          String     @id @default(cuid())
  title       String
  stage       DealStage  @default(NEW)
  amountMinor Int        @default(0)
  currency    Currency   @default(UAH)
  lostReason  String?
  closedAt    DateTime?
  companyId   String?
  company     Company?   @relation(fields: [companyId], references: [id])
  contactId   String?
  contact     Contact?   @relation(fields: [contactId], references: [id])
  leadId      String?    @unique
  lead        Lead?      @relation(fields: [leadId], references: [id])
  // Угода, створена із замовлення B2B/B2G (1:1).
  orderId     String?    @unique
  order       Order?     @relation(fields: [orderId], references: [id])
  ownerId     String?
  owner       User?      @relation("DealOwner", fields: [ownerId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  activities Activity[]
  tasks      Task[]

  @@index([stage])
  @@index([ownerId])
}

// Історія комунікацій: по угоді або по ліду.
model Activity {
  id        String   @id @default(cuid())
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String   // call | email | meeting | note | system
  content   String?
  authorId  String?
  author    User?    @relation("ActivityAuthor", fields: [authorId], references: [id])
  createdAt DateTime @default(now())

  @@index([dealId])
  @@index([leadId])
}

model Task {
  id         String    @id @default(cuid())
  dealId     String?
  deal       Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title      String
  dueAt      DateTime?
  done       Boolean   @default(false)
  assigneeId String?
  assignee   User?     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdAt  DateTime  @default(now())

  @@index([dealId])
  @@index([leadId])
  @@index([assigneeId, done])
}

// ─────────────────── Back-office (Phase 6) ───────────────────
// Журнал дій персоналу: хто, що і з якими даними змінив. Запис лишається після видалення користувача.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action    String   // напр. "order.status", "product.update", "user.role"
  entity    String   // Order | Product | User | Organization | Lead | Deal | Search
  entityId  String?
  data      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([actorId, createdAt])
}

// Факт розрахунку у формі підбору — знаменник конверсії «підбір → заявка → угода».
model SelectorRun {
  id           String    @id @default(cuid())
  recommendedW Int
  phase        PhaseType
  usageMode    String
  itemsCount   Int
  createdAt    DateTime  @default(now())

  @@index([createdAt])
}
