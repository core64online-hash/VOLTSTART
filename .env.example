# ─────────────────────────────────────────────────────────────
# VOLTSTAR — приклад змінних середовища. Скопіюйте у .env і заповніть.
# НЕ комітьте реальний .env з секретами.
# ─────────────────────────────────────────────────────────────

# --- Загальне ---
NODE_ENV=development

# --- API (apps/api) ---
API_PORT=4000
# Дозволені origin-и для CORS (через кому); також — допустимі returnUrl після оплати
API_CORS_ORIGINS=http://localhost:3000
# Публічна адреса API — з неї будуються URL вебхуків платіжних провайдерів
API_PUBLIC_URL=http://localhost:4000

# --- База даних (PostgreSQL) ---
DATABASE_URL=postgresql://voltstar:voltstar@localhost:5432/voltstar?schema=public

# --- Redis (кеш, черги BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Пошук (Typesense) ---
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=voltstar_dev_key
# true — переіндексувати каталог під час старту API (інакше: POST /api/search/reindex або pnpm search:reindex)
TYPESENSE_SYNC_ON_START=false

# --- Auth / JWT ---
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DEFAULT_LOCALE=uk
# Публічна адреса web — для посилань у листах (відстеження замовлення, скидання паролю)
WEB_PUBLIC_URL=http://localhost:3000

# --- Платежі: Україна (WayForPay) ---
WAYFORPAY_MERCHANT_ACCOUNT=
WAYFORPAY_MERCHANT_SECRET=
WAYFORPAY_DOMAIN=

# --- Платежі: Україна (LiqPay, альтернатива) ---
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
# true — приймати статус "sandbox" як успішну оплату (лише для тестів!)
LIQPAY_SANDBOX=false

# --- Платежі: міжнародні (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- Оплата за рахунком (B2B/B2G): реквізити отримувача ---
# Провайдер BANK_INVOICE вмикається, коли задано INVOICE_IBAN.
INVOICE_IBAN=
INVOICE_RECIPIENT="ТОВ «ВОЛЬТСТАР»"
INVOICE_RECIPIENT_EDRPOU=
# Адреса постачальника в PDF-документах (необовʼязково)
INVOICE_RECIPIENT_ADDRESS=

# --- Файлове сховище (S3-сумісне: Cloudflare R2 / AWS S3) ---
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=voltstar
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Email (Resend / SendGrid; локально — Mailhog SMTP) ---
# Без SMTP_HOST листи лише пишуться в лог API.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="VOLTSTAR <noreply@voltstar.local>"
# Куди слати сповіщення про нові й оплачені замовлення (необовʼязково)
MANAGER_EMAIL=

# --- Сповіщення менеджерам (Telegram-бот, опційно) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Спостережуваність (опційно) ---
SENTRY_DSN=
