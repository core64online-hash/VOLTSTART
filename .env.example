# ─────────────────────────────────────────────────────────────
# VOLTSTAR — приклад змінних середовища. Скопіюйте у .env і заповніть.
# НЕ комітьте реальний .env з секретами.
# ─────────────────────────────────────────────────────────────

# --- Загальне ---
NODE_ENV=development

# --- API (apps/api) ---
API_PORT=4000
# Дозволені origin-и для CORS (через кому)
API_CORS_ORIGINS=http://localhost:3000

# --- База даних (PostgreSQL) ---
DATABASE_URL=postgresql://voltstar:voltstar@localhost:5432/voltstar?schema=public

# --- Redis (кеш, черги BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Пошук (Typesense) ---
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=voltstar_dev_key

# --- Auth / JWT ---
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DEFAULT_LOCALE=uk

# --- Платежі: Україна (WayForPay) ---
WAYFORPAY_MERCHANT_ACCOUNT=
WAYFORPAY_MERCHANT_SECRET=
WAYFORPAY_DOMAIN=

# --- Платежі: Україна (LiqPay, альтернатива) ---
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=

# --- Платежі: міжнародні (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- Файлове сховище (S3-сумісне: Cloudflare R2 / AWS S3) ---
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=voltstar
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Email (Resend / SendGrid; локально — Mailhog SMTP) ---
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM="VOLTSTAR <noreply@voltstar.local>"

# --- Сповіщення менеджерам (Telegram-бот, опційно) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Спостережуваність (опційно) ---
SENTRY_DSN=
