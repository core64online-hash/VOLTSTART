# ─────────────────────────────────────────────────────────────
# Змінні production-стеку (docker-compose.prod.yml). У Coolify — вкладка
# Environment Variables ресурсу; на VPS — скопіюйте у deploy/.env.prod (НЕ комітьте).
# Секрети генеруйте так:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────

# Публічна адреса сайту (API — на тому ж домені під /api)
SITE_URL=https://voltstar.ua
# Лише для docker-compose.caddy.yml (VPS без Coolify)
SITE_DOMAIN=voltstar.ua
ACME_EMAIL=admin@voltstar.ua

# Обовʼязкові секрети
POSTGRES_PASSWORD=
JWT_SECRET=
INTERNAL_API_TOKEN=
TYPESENSE_API_KEY=
# Токен для Prometheus (без нього /api/metrics у production вимкнено)
METRICS_TOKEN=

# Версія, що деплоїться (тег образів і APP_VERSION): SHA коміту. Coolify передає її сам —
# там цю змінну НЕ задавайте; на VPS: SOURCE_COMMIT=$(git rev-parse HEAD)
SOURCE_COMMIT=

# Реквізити володільця персональних даних (сторінка політики)
LEGAL_NAME="ТОВ «ВОЛЬТСТАР»"
LEGAL_EDRPOU=
PRIVACY_EMAIL=privacy@voltstar.ua

# Пошта (Resend/SendGrid/Mailgun SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="VOLTSTAR <noreply@voltstar.ua>"
MANAGER_EMAIL=

# Сповіщення менеджерам у Telegram (необовʼязково)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Платежі (бойові ключі)
WAYFORPAY_MERCHANT_ACCOUNT=
WAYFORPAY_MERCHANT_SECRET=
WAYFORPAY_DOMAIN=voltstar.ua
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Оплата за рахунком (B2B/B2G)
INVOICE_IBAN=
INVOICE_RECIPIENT="ТОВ «ВОЛЬТСТАР»"
INVOICE_RECIPIENT_EDRPOU=
INVOICE_RECIPIENT_ADDRESS=

# Бекапи: скільки копій зберігати й інтервал (сек)
BACKUP_KEEP=14
BACKUP_INTERVAL_SEC=86400

# Звіти про помилки API й сайту (Sentry / GlitchTip). Порожньо — вимкнено.
# DSN для браузера вшивається під час збірки — після зміни потрібна нова збірка.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Копії бекапів поза сервером (S3/R2/B2). Порожній OFFSITE_S3_BUCKET — вимкнено. Див. RUNBOOK, розділ 6.
OFFSITE_S3_BUCKET=
OFFSITE_S3_ENDPOINT=
OFFSITE_S3_PROVIDER=Other
OFFSITE_S3_REGION=auto
OFFSITE_S3_ACCESS_KEY_ID=
OFFSITE_S3_SECRET_ACCESS_KEY=
# Шифрування на сервері (рекомендовано); збережіть пароль і поза сервером
OFFSITE_CRYPT_PASSWORD=
OFFSITE_S3_PREFIX=voltstar
OFFSITE_KEEP_DAYS=30
OFFSITE_INTERVAL_SEC=3600
